# MATLAB
*.asv

# temporary
/temp

# inputs
/data

# outputs
# 図のうち、スライド用（results/figures/<発表名>/slides）と進捗報告用（results/figures/progress）
# だけを他PCと共有するため追跡対象にする。原稿用（results/figures/<発表名>/paper）、
# 実験の実行フォルダ（results/<実験名>/<YYYY-MMDD_説明>）、results/figures の直下のファイルは無視する（issue #28）
/results/*
!/results/figures/
/results/figures/*
!/results/figures/*/
/results/figures/*/*
!/results/figures/*/slides/
!/results/figures/progress/*
/audioFiles

# experiment results (.mat)
# fitGroove の手動操作なしには作り直せないので、消さずに別途バックアップすること
/experiments

# AI 
/.agents/*
/.claude/*
# サブエージェントの定義とskillは他PCと共有するため追跡対象にする
!/.claude/agents/
!/.claude/skills/
# 共有の設定（worktree の分岐元、ロックを確かめるフック）は worktree にも入るように追跡する。
# 個人の許可設定 settings.local.json は追跡しない（post-checkout が worktree へコピーする）。
!/.claude/settings.json

# editor
# VS Code の設定は個人の好み（表示など）なので追跡しない
/.vscode
