# MATLAB
*.asv

# temporary
/temp

# inputs
/data

# outputs
# results/figures/slides と results/figures/progress のみ他PCと共有するため追跡対象にする
# （results/figures/paperを含め、それ以外のresults配下は引き続き無視する）
/results/*
!/results/figures/
/results/figures/*
!/results/figures/slides/
!/results/figures/progress/
/audioFiles

# experiment results (.mat)
# fitGroove の手動操作なしには作り直せないので、消さずに別途バックアップすること
/experiments

# AI 
/.agents/*
/.claude/*
# サブエージェントの定義とskillは他PCと共有するため追跡対象にする
!/.claude/agents/
!/.claude/skills/

# editor
# VS Code の設定は個人の好み（表示など）なので追跡しない
/.vscode



# editor
/.vscode
