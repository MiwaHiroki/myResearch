%{
[B,(winsize)] = smoothdata(A,(dim,method,window))
各列について「移動平均を使用してAのエントリを平滑化する」

%}

%%
% データの読み込み
dir = "./data/";
datanames = ["y_comb" "amplitude" "amplitude2"]';
laps = 1;


for i=1:3
    load(dir + datanames(i) +"_"+ num2str(laps) + "cycles.mat")
end

%%

[y_smooth_movmean,winsize1] = smoothdata(y_comb,"movmean");
[y_smooth_movmedian,winsize2] = smoothdata(y_comb,"movmedian");
[y_smooth_lowess,winsize3]= smoothdata(y_comb,"lowess");

%%
% subplot
%{
figure;subplot(2,1,1)
plot(y_comb);title("y comb");xlabel("sample");ylabel("y")

subplot(2,1,2)
% figure;
plot(y_smooth);
title("y smooth");xlabel("sample");ylabel("y");
%}

% 重ねて表示
figure;plot(y_comb);
hold on 
plot(y_smooth_movmean);
title("data");xlabel("sample");ylabel("y");legend;axis tight
xlim([1.33 1.36]*10^5)
%%
num_samples = length(y_comb);
fs = round(num_samples /(60/78 * laps));

amp_smooth = (y_smooth_movmean - min(y_smooth_movmean)) / (max(y_smooth_movmean) - min(y_smooth_movmean)) * 2 - 1;
amp_smooth = amp_smooth - mean(amp_smooth);
amp_smooth(abs(amp_smooth)>1)=0;
soundCheck(amp_smooth,fs,"smoothed amplitude");

%%
% 外れ値の検出
TF = isoutlier(y_comb);
idx = find(TF);

figure;plot(y_comb);
hold on
plot(idx,y_comb(idx),"o","MarkerSize",2);
hold off

%%
% 外れ値を検出し、置き換える
y_fillout = filloutliers(y_comb,"previous");

figure;plot(y_comb);
hold on
plot(y_fillout);
hold off
title("data");legend;axis tight;xlabel("sample");ylabel("y")


%%
y_fillout_movmean = smoothdata(y_fillout,"movmean",25);
plot(y_fillout);
title("data");legend;axis tight;xlabel("sample");ylabel("y")
